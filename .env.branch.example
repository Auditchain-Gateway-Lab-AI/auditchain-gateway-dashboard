# Use in the Besu/internal server branch checkout.
AUDITCHAIN_DASHBOARD_CONTAINER=auditchain-branch-dashboard
DASHBOARD_HOST_BIND_IP=0.0.0.0
DASHBOARD_HOST_PORT=13001
# This URL is embedded in the browser bundle. Use an address reachable by the
# browser user over the private network, not the Docker service name.
DASHBOARD_API_BASE_URL=http://replace-with-besu-or-internal-private-ip:18080/api
